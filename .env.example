# ============================================================
# MediFind — Environment Variables
# Copy this file to `.env` and fill in your values.
# All secrets stay in .env (which is gitignored).
# ============================================================

# --- Database (SQLite, default for dev) ---
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- Authentication ---
# Set this to a long random string for session cookie signing (recommended for production)
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# --- Maps Integration (OPTIONAL — both default to OFF) ---
# The app works fully without any maps API keys (uses Haversine distance
# math on stored lat/lng). Configure keys to enable auto-geocoding and
# richer map UI. Both can be enabled simultaneously; Mapbox takes priority.

# Mapbox (recommended — 50,000 free requests/month)
# Get a token at: https://account.mapbox.com/access-tokens/
# The NEXT_PUBLIC_ prefix is required because Mapbox needs the token client-side for map tiles.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.eyJ1Ijoi..."
# Optional: server-side token for server-side geocoding only (no NEXT_PUBLIC_ prefix)
# MAPBOX_ACCESS_TOKEN="sk.eyJ1Ijoi..."

# Google Maps Platform ($200/month free credit ≈ 28k requests)
# Get a key at: https://console.cloud.google.com/google/maps-apis
# Restrict this key to your domain in Google Cloud Console!
GOOGLE_MAPS_API_KEY="AIzaSy..."
# Optional: a separate browser key for client-side Maps JavaScript API + Places Autocomplete
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSy..."

# --- App Config ---
NEXT_PUBLIC_APP_NAME="MediFind"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Production Notes ---
# - Set NODE_ENV=production when deploying
# - Use PostgreSQL/MySQL instead of SQLite for production (change prisma/schema.prisma provider)
# - Add rate limiting middleware (e.g., Upstash, or via Vercel Edge Middleware)
# - Set up proper email/SMS for appointment notifications
# - Enable HTTPS only (HSTS) via your hosting provider
